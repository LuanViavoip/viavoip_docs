# Copie para `.env` e ajuste se necessário. Valores apenas para desenvolvimento local.

# PostgreSQL (usado pelo docker-compose.yml)
POSTGRES_USER=viavoip
POSTGRES_PASSWORD=viavoip_dev
POSTGRES_DB=viavoip_docs
POSTGRES_PORT=5432

# Conexão usada pelo Prisma e pela aplicação
DATABASE_URL="postgresql://viavoip:viavoip_dev@localhost:5432/viavoip_docs?schema=public"

# Onde a documentação importada é armazenada (fora de public/). Padrão: ./storage
# STORAGE_DIR=./storage

# Administração: gere o hash com pnpm admin:hash. Nunca use NEXT_PUBLIC_* para estes valores.
ADMIN_PASSWORD_HASH=
# Segredo aleatório de ao menos 32 bytes (ex.: openssl rand -hex 32)
ADMIN_SESSION_SECRET=

# Opcional, somente para testes: banco PostgreSQL isolado e descartável.
# TEST_DATABASE_URL=postgresql://...
